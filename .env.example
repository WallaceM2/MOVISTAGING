# Local Android emulator. Replace with the HTTPS API address in shared environments.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Public Mapbox token. Never put a secret/server token in an EXPO_PUBLIC variable.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Quando configurar FCM, coloque google-services.json na raiz e defina:
# GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_JSON=
