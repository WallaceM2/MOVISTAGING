# Android Emulator: API local no host da máquina.
# Para staging/produção, substitua pela URL HTTPS pública da API MOVI.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Token público Mapbox (pk...). Não use token secreto sk... no aplicativo.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Quando configurar FCM, coloque google-services.json na raiz e defina:
# GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_JSON=

# Token privado de download Mapbox: só para build/prebuild local ou secret de build.
MAPBOX_DOWNLOAD_TOKEN=
