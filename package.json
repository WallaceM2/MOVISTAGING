{
  "name": "movi-passageiro",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "node scripts/run-android.cjs",
    "ios": "expo run:ios",
